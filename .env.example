NODE_ENV=development
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:5173
ADMIN_PUBLIC_URL=http://localhost:5174
DATABASE_URL=mysql://ysk:ysk@localhost:3306/ysk_kit
JWT_SECRET=change-me-in-dev-only
JWT_ACCESS_TTL=15m
OTP_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379
SMTP_URL=
MAIL_FROM=ysk-kit@localhost
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
RUN_WORKERS=1
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
XAI_API_KEY=
LLM_MODEL=grok-4.7
HTTP_ADAPTER=express
CRYPTO_MASTER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# docker compose up -d jaeger → UI http://localhost:16686 ; OTLP HTTP http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP metrics (not Jaeger). Collector / Prometheus remote OTLP, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# unset → API ysk-api, worker ysk-worker; set per process for a custom name
OTEL_SERVICE_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# 0 disables. Default 300 req / 60s per IP. Skips /health /ready /metrics.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
