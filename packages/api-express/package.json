{
  "name": "@ysk/api-express",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ysk/apikey": "workspace:*",
    "@ysk/api-http": "workspace:*",
    "@ysk/auth": "workspace:*",
    "@ysk/contracts": "workspace:*",
    "@ysk/domain-kernel": "workspace:*",
    "express": "^5.2.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.5.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "pino": "^10.3.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
