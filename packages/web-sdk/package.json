{
  "name": "@ysk/web-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ysk/contracts": "workspace:*",
    "@ysk/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.75.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@tanstack/react-query": "^5.75.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.0.0",
    "react": "19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
