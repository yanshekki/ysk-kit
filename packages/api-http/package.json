{
  "name": "@ysk-kit/api-http",
  "version": "1.2.3",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ysk-kit/auth": "workspace:*",
    "@ysk-kit/contracts": "workspace:*",
    "@ysk-kit/domain-kernel": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "license": "MIT",
  "description": "Framework-free HTTP handlers, OpenAPI, and rate limits for YSK Kit.",
  "homepage": "https://ysk.hk/products/ysk-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanshekki/ysk-kit.git",
    "directory": "packages/api-http"
  }
}
