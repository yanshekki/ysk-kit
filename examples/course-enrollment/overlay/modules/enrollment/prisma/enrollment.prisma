model Enrollment {
  id          String   @id @default(uuid())
  courseId    String
  studentName String
  email       String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([courseId, email])
  @@index([authorId])
  @@index([courseId])
}
