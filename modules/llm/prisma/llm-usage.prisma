// Fragment already applied in apps/api/prisma/schema.prisma (LlmUsage).
// ysk add llm is idempotent for the saas flavor.

model LlmUsage {
  id               String   @id @default(uuid())
  userId           String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costMicros       Int?
  requestId        String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
