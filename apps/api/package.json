{
  "name": "@ysk-kit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "tsx --env-file=../../.env src/infra/seed.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "9.10.1",
    "@bull-board/express": "9.10.1",
    "@bull-board/fastify": "9.10.1",
    "@fastify/cors": "^11.0.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@ysk-kit/api-express": "workspace:*",
    "@ysk-kit/api-fastify": "workspace:*",
    "@ysk-kit/api-http": "workspace:*",
    "@ysk-kit/apikey": "workspace:*",
    "@ysk-kit/application": "workspace:*",
    "@ysk-kit/auth": "workspace:*",
    "@ysk-kit/config": "workspace:*",
    "@ysk-kit/contracts": "workspace:*",
    "@ysk-kit/domain-kernel": "workspace:*",
    "@ysk-kit/jobs": "workspace:*",
    "@ysk-kit/llm": "workspace:*",
    "@ysk-kit/logger": "workspace:*",
    "@ysk-kit/mail": "workspace:*",
    "@ysk-kit/observability": "workspace:*",
    "@ysk-kit/push": "workspace:*",
    "@ysk-kit/realtime": "workspace:*",
    "@ysk-kit/storage": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/pg": "^8.15.5",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
