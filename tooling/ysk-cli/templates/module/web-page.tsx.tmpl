import { Create{{pascal}}CommandSchema } from '@ysk/contracts';
import { Button, Input, Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@ysk/ui';
import { create{{pascal}}Hooks } from '@ysk/web-sdk';
import { type FormEvent, useState } from 'react';
import { api } from '../../lib/client';

const hooks = create{{pascal}}Hooks(api);

export function {{pascal}}Page() {
  const list = hooks.useList();
  const create = hooks.useCreate();
  const [title, setTitle] = useState('');
  const [body, setBody] = useState('');
  const [formError, setFormError] = useState<string | null>(null);

  const onSubmit = (event: FormEvent) => {
    event.preventDefault();
    const parsed = Create{{pascal}}CommandSchema.safeParse({ title, body });
    if (!parsed.success) {
      setFormError(parsed.error.issues[0]?.message ?? 'Invalid');
      return;
    }
    create.mutate(parsed.data, {
      onSuccess: () => {
        setTitle('');
        setBody('');
        setFormError(null);
      },
      onError: (error) => setFormError(error.message),
    });
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-semibold">{{pascal}}</h1>
      {list.error ? <p className="text-sm text-red-600">{list.error.message}</p> : null}
      {formError ? <p className="text-sm text-red-600">{formError}</p> : null}
      <form onSubmit={onSubmit} className="grid max-w-md gap-3">
        <label className="grid gap-1 text-sm" htmlFor="{{kebab}}-title">
          Title
          <Input id="{{kebab}}-title" value={title} onChange={(e) => setTitle(e.target.value)} required />
        </label>
        <label className="grid gap-1 text-sm" htmlFor="{{kebab}}-body">
          Body
          <Input id="{{kebab}}-body" value={body} onChange={(e) => setBody(e.target.value)} />
        </label>
        <Button type="submit" disabled={create.isPending}>
          Create
        </Button>
      </form>
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>Title</TableHead>
            <TableHead>Body</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {(list.data?.items ?? []).map((item) => (
            <TableRow key={item.id}>
              <TableCell>{item.title}</TableCell>
              <TableCell>{item.body}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </section>
  );
}
