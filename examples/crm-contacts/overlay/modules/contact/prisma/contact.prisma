model Contact {
  id        String     @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  status    String
  authorId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  followUps FollowUp[]

  @@unique([authorId, email])
  @@index([authorId])
}
