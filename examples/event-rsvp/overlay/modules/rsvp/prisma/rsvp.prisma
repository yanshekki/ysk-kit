model Rsvp {
  id           String   @id @default(uuid())
  eventId      String
  attendeeName String
  email        String
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, email])
  @@index([authorId])
  @@index([eventId])
}
