{
  "name": "@ysk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "9.10.1",
    "@bull-board/express": "9.10.1",
    "@bull-board/fastify": "9.10.1",
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.8.2",
    "@ysk/api-express": "workspace:*",
    "@ysk/api-fastify": "workspace:*",
    "@ysk/api-http": "workspace:*",
    "@ysk/apikey": "workspace:*",
    "@ysk/application": "workspace:*",
    "@ysk/auth": "workspace:*",
    "@ysk/config": "workspace:*",
    "@ysk/contracts": "workspace:*",
    "@ysk/domain-kernel": "workspace:*",
    "@ysk/jobs": "workspace:*",
    "@ysk/llm": "workspace:*",
    "@ysk/logger": "workspace:*",
    "@ysk/mail": "workspace:*",
    "@ysk/observability": "workspace:*",
    "@ysk/push": "workspace:*",
    "@ysk/realtime": "workspace:*",
    "@ysk/storage": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "pino": "^9.6.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.8.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
